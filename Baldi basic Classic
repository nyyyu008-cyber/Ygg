--------------------------------------------------
-- NOCLIP
--------------------------------------------------

local function RestoreNoclip()

    for Part,OldValue in pairs(NoclipCache) do

        if Part and Part.Parent then

            pcall(function()
                Part.CanCollide = OldValue
            end)
        end
    end

    table.clear(NoclipCache)
end

AddConnection(
    RunService.Stepped:Connect(function()

        if not Noclip then
            return
        end

        local Character = GetCharacter()

        if not Character then
            return
        end

        for _,Part in ipairs(
            Character:GetDescendants()
        ) do

            if Part:IsA("BasePart") then

                if NoclipCache[Part] == nil then
                    NoclipCache[Part] =
                        Part.CanCollide
                end

                Part.CanCollide = false
            end
        end
    end)
)

--------------------------------------------------
-- BALDI FINDER
--------------------------------------------------

local function FindBaldi()

    local Result = {}

    for _,Object in ipairs(
        Workspace:GetDescendants()
    ) do

        if Object:IsA("Model")
            and Object.Name:lower():find("baldi") then

            table.insert(Result,Object)
        end
    end

    return Result
end

local function GetModelRoot(Model)

    return Model.PrimaryPart
        or Model:FindFirstChild(
            "HumanoidRootPart"
        )
        or Model:FindFirstChildWhichIsA(
            "BasePart",
            true
        )
end

--------------------------------------------------
-- DELETE / RESTORE BALDI
--------------------------------------------------

local function HideBaldi()

    for _,Model in ipairs(
        FindBaldi()
    ) do

        for _,Part in ipairs(
            Model:GetDescendants()
        ) do

            if Part:IsA("BasePart") then

                if HiddenBaldiCache[Part] == nil then
                    HiddenBaldiCache[Part] =
                        Part.LocalTransparencyModifier
                end

                Part.LocalTransparencyModifier = 1
            end
        end
    end
end

local function RestoreBaldi()

    for Part,OldValue in pairs(
        HiddenBaldiCache
    ) do

        if Part and Part.Parent then

            pcall(function()
                Part.LocalTransparencyModifier =
                    OldValue
            end)
        end
    end

    table.clear(HiddenBaldiCache)
end

--------------------------------------------------
-- FREEZE BALDI
--------------------------------------------------

local function FreezeBaldiNow()

    FreezeBaldi = true

    for _,Model in ipairs(
        FindBaldi()
    ) do

        for _,Part in ipairs(
            Model:GetDescendants()
        ) do

            if Part:IsA("BasePart") then

                if FreezeCache[Part] == nil then
                    FreezeCache[Part] =
                        Part.Anchored
                end

                Part.Anchored = true
            end
        end
    end
end

local function UnfreezeBaldi()

    FreezeBaldi = false

    for Part,OldValue in pairs(
        FreezeCache
    ) do

        if Part and Part.Parent then

            pcall(function()
                Part.Anchored = OldValue
            end)
        end
    end

    table.clear(FreezeCache)
end

--------------------------------------------------
-- BRING BALDI
--------------------------------------------------

local function BringBaldi()

    local Root = GetRoot()

    if not Root then
        return
    end

    local Number = 0

    for _,Model in ipairs(
        FindBaldi()
    ) do

        local TargetRoot =
            GetModelRoot(Model)

        if TargetRoot then

            Number += 1

            pcall(function()

                TargetRoot.CFrame =
                    Root.CFrame *
                    CFrame.new(
                        0,
                        0,
                        -7 * Number
                    )
            end)
        end
    end
end

